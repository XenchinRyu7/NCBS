---
import '../styles/globals.css';
import { apiCall } from '../lib/api';

const tokenCookie = Astro.cookies.get('cbs_token')?.value;

let user: any = null;
let trialBalance: any = null;
let auditLogs: any[] = [];
let transactions: any[] = [];
let virtualAccounts: any[] = [];

if (tokenCookie) {
  const meRes = await apiCall<any>('/v1/auth/me', { token: tokenCookie });
  if (meRes.ok) {
    user = meRes.data;

    // Fetch accounts
    const accRes = await apiCall<any[]>('/v1/accounts', { token: tokenCookie });
    if (accRes.ok) {
      user.accounts = accRes.data || [];
    }

    // Fetch transactions
    const txRes = await apiCall<any[]>('/v1/transactions', { token: tokenCookie });
    if (txRes.ok) {
      transactions = txRes.data || [];
    }

    // If auditor or admin, fetch trial balance and audit logs
    if (user?.role === 'AUDITOR' || user?.role === 'ADMIN') {
      const tbRes = await apiCall<any>('/v1/ledger/trial-balance', { token: tokenCookie });
      if (tbRes.ok) trialBalance = tbRes.data;

      const auditRes = await apiCall<any[]>('/v1/audit-logs', { token: tokenCookie });
      if (auditRes.ok) auditLogs = auditRes.data || [];
    }
  }
}
---

<!doctype html>
<html lang="id" class="dark" data-color-theme="custom">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Core Banking Console — Nusantara CBS</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏦</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased flex flex-col md:flex-row selection:bg-primary/20 selection:text-primary">
    {/* ========================================================================= */}
    {/* 1. SIDEBAR NAVIGATION (Ethereal UI AppShell Standard) */}
    {/* ========================================================================= */}
    <aside class="w-full md:w-64 border-b md:border-b-0 md:border-r border-border bg-sidebar flex flex-col justify-between shrink-0">
      <div class="p-4 space-y-6">
        {/* Brand Header */}
        <div class="flex items-center gap-2.5 px-2">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground font-black text-sm shadow-sm shadow-primary/20">
            N
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="font-bold tracking-tight text-xs text-foreground">NUSANTARA CBS</span>
              <span class="rounded bg-emerald-500/10 px-1 text-[9px] font-mono text-emerald-400 border border-emerald-500/20">v2.4</span>
            </div>
            <span class="text-[10px] text-muted-foreground font-mono block">CORE BANKING ENGINE</span>
          </div>
        </div>

        {/* Navigation Links */}
        <nav class="space-y-1 text-xs">
          <button
            onclick="switchTab('overview')"
            id="tab-btn-overview"
            class="tab-btn w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-foreground bg-secondary font-medium transition"
          >
            <svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            Ringkasan Akun
          </button>

          <button
            onclick="switchTab('ledger')"
            id="tab-btn-ledger"
            class="tab-btn w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-muted-foreground hover:bg-secondary/50 hover:text-foreground font-medium transition"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
            Jurnal Mutasi
          </button>

          <button
            onclick="switchTab('transfer')"
            id="tab-btn-transfer"
            class="tab-btn w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-muted-foreground hover:bg-secondary/50 hover:text-foreground font-medium transition"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
            Transfer Dana
          </button>

          <button
            onclick="switchTab('virtual-accounts')"
            id="tab-btn-virtual-accounts"
            class="tab-btn w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-muted-foreground hover:bg-secondary/50 hover:text-foreground font-medium transition"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Virtual Accounts
          </button>

          {/* Conditional Branch Operations */}
          <div id="nav-branch-group" class="pt-2">
            <span class="px-3 text-[10px] font-mono uppercase tracking-wider text-muted-foreground">OPERASIONAL CABANG</span>
            <button
              onclick="switchTab('branch')"
              id="tab-btn-branch"
              class="tab-btn w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-muted-foreground hover:bg-secondary/50 hover:text-foreground font-medium transition mt-1"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              Teller &amp; CS Desk
            </button>
          </div>

          {/* Conditional Auditor & Admin */}
          <div id="nav-audit-group" class="pt-2">
            <span class="px-3 text-[10px] font-mono uppercase tracking-wider text-muted-foreground">REGULATOR &amp; AUDIT</span>
            <button
              onclick="switchTab('audit')"
              id="tab-btn-audit"
              class="tab-btn w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-muted-foreground hover:bg-secondary/50 hover:text-foreground font-medium transition mt-1"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              Trial Balance &amp; OJK
            </button>
          </div>
        </nav>
      </div>

      {/* User Session Profile in Sidebar Footer */}
      <div class="p-4 border-t border-border bg-sidebar-accent/50 space-y-3">
        <div class="flex items-center justify-between">
          <div class="space-y-0.5 truncate pr-2">
            <div id="sidebar-name" class="text-xs font-bold text-foreground truncate">
              {user?.full_name || 'Memuat...'}
            </div>
            <div id="sidebar-cif" class="text-[10px] font-mono text-muted-foreground truncate">
              {user?.cif_number || 'CIF-PENDING'}
            </div>
          </div>
          <span id="sidebar-role" class="rounded px-2 py-0.5 text-[10px] font-bold font-mono bg-primary/10 text-primary border border-primary/20 shrink-0">
            {user?.role || 'AUTH'}
          </span>
        </div>

        <button
          onclick="logout()"
          class="w-full rounded-lg border border-border bg-secondary py-1.5 text-[11px] font-semibold text-secondary-foreground hover:bg-destructive/20 hover:text-destructive hover:border-destructive/30 transition text-center"
        >
          Akhiri Sesi (Keluar)
        </button>
      </div>
    </aside>

    {/* ========================================================================= */}
    {/* 2. MAIN TELEMETRY CONTENT VIEWPORT */}
    {/* ========================================================================= */}
    <div class="flex-1 flex flex-col min-w-0">
      {/* Top Telemetry Header */}
      <header class="h-14 border-b border-border bg-card/50 backdrop-blur-md px-6 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-3">
          <h1 id="view-title" class="text-sm font-bold text-foreground">
            Ringkasan Akun &amp; Likuiditas
          </h1>
          <span class="text-muted-foreground text-xs">&bull;</span>
          <span id="view-subtitle" class="text-xs text-muted-foreground font-mono">
            IDR &bull; Zero-Trust Verified
          </span>
        </div>

        <div class="flex items-center gap-3">
          {/* General Ledger Live Invariant Indicator */}
          <div class="flex items-center gap-2 rounded-full border border-border bg-muted/60 px-3 py-1 text-xs">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            <span class="text-[10px] text-muted-foreground font-mono hidden sm:inline">GL INTEGRITY:</span>
            <span class="text-[10px] font-bold font-mono text-emerald-400">BALANCED (Δ Rp 0)</span>
          </div>

          <a
            href="http://localhost:8080/docs"
            target="_blank"
            class="rounded-lg border border-border bg-secondary px-2.5 py-1 text-xs font-medium text-muted-foreground hover:text-foreground transition flex items-center gap-1"
          >
            <span class="hidden sm:inline">API</span> Docs
          </a>
        </div>
      </header>

      {/* Main Workspace Body */}
      <main class="flex-1 p-6 overflow-y-auto space-y-6">
        {/* Global Toast / Notification Box */}
        <div id="toast-banner" class="hidden rounded-xl border p-4 text-xs font-semibold"></div>

        {/* ------------------------------------------------------------------- */}
        {/* TAB 1: OVERVIEW & ACCOUNTS */}
        {/* ------------------------------------------------------------------- */}
        <section id="pane-overview" class="tab-pane space-y-6">
          {/* KPI Metrics Grid */}
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="rounded-xl border border-border bg-card p-4 space-y-1">
              <span class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground">Saldo Rekening Utama</span>
              <div id="kpi-balance" class="text-2xl font-bold font-mono text-foreground">Rp 0</div>
              <p class="text-[11px] text-muted-foreground font-mono" id="kpi-acc-no">Rekening: -</p>
            </div>

            <div class="rounded-xl border border-border bg-card p-4 space-y-1">
              <span class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground">Dana Tersedia (Available)</span>
              <div id="kpi-available" class="text-2xl font-bold font-mono text-emerald-400">Rp 0</div>
              <p class="text-[11px] text-muted-foreground font-mono">Hold Balance: Rp 0</p>
            </div>

            <div class="rounded-xl border border-border bg-card p-4 space-y-1">
              <span class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground">Batas Harian (Tier Limit)</span>
              <div id="kpi-limit" class="text-2xl font-bold font-mono text-foreground">Rp 0</div>
              <p class="text-[11px] text-muted-foreground font-mono" id="kpi-tier">TIER: -</p>
            </div>

            <div class="rounded-xl border border-border bg-card p-4 space-y-1">
              <span class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground">Status Rekening</span>
              <div id="kpi-status" class="text-2xl font-bold font-mono text-emerald-400">ACTIVE</div>
              <p class="text-[11px] text-muted-foreground font-mono">0 Failed PIN Attempts</p>
            </div>
          </div>

          {/* Quick Transaction Action Bar */}
          <div class="flex flex-wrap items-center gap-2.5 p-4 rounded-xl border border-border bg-card/60">
            <span class="text-xs font-semibold text-muted-foreground mr-2">Aksi Cepat:</span>
            <button onclick="switchTab('transfer')" class="rounded-lg bg-primary px-3 py-1.5 text-xs font-bold text-primary-foreground hover:brightness-110 shadow-sm transition">
              Transfer Dana
            </button>
            <button onclick="switchTab('virtual-accounts')" class="rounded-lg border border-border bg-secondary px-3 py-1.5 text-xs font-semibold text-secondary-foreground hover:bg-muted transition">
              Bayar / Kelola VA
            </button>
            <button onclick="switchTab('ledger')" class="rounded-lg border border-border bg-secondary px-3 py-1.5 text-xs font-semibold text-secondary-foreground hover:bg-muted transition">
              Lihat Riwayat Mutasi
            </button>
          </div>

          {/* Recent Ledger Entries Snippet */}
          <div class="rounded-xl border border-border bg-card overflow-hidden">
            <div class="p-4 border-b border-border flex items-center justify-between">
              <div>
                <h3 class="text-xs font-bold text-foreground uppercase tracking-wider font-mono">Mutasi Terbaru</h3>
                <p class="text-[11px] text-muted-foreground">Posting jurnal terverifikasi double-entry</p>
              </div>
              <button onclick="switchTab('ledger')" class="text-xs text-primary font-semibold hover:underline">
                Lihat Semua Mutasi &rarr;
              </button>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs">
                <thead class="border-b border-border bg-muted/30 font-mono text-muted-foreground text-[11px]">
                  <tr>
                    <th class="p-3">WAKTU</th>
                    <th class="p-3">KETERANGAN</th>
                    <th class="p-3">ARAH</th>
                    <th class="p-3 text-right">JUMLAH</th>
                    <th class="p-3 text-right">SALDO AKHIR</th>
                  </tr>
                </thead>
                <tbody id="overview-recent-tbody" class="divide-y divide-border">
                  <tr>
                    <td colspan="5" class="p-4 text-center text-muted-foreground font-mono text-xs">Memuat mutasi terbaru...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        {/* ------------------------------------------------------------------- */}
        {/* TAB 2: TRANSACTION LEDGER & STATEMENT */}
        {/* ------------------------------------------------------------------- */}
        <section id="pane-ledger" class="tab-pane hidden space-y-4">
          <div class="rounded-xl border border-border bg-card overflow-hidden">
            <div class="p-4 border-b border-border flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <h2 class="text-sm font-bold text-foreground">Jurnal Mutasi Lengkap</h2>
                <p class="text-xs text-muted-foreground">Catatan debit dan kredit mutlak tidak dapat diubah (immutable postings)</p>
              </div>
              <button
                onclick="loadStatement()"
                class="rounded-lg border border-border bg-secondary px-3 py-1 text-xs text-secondary-foreground hover:bg-muted transition font-mono"
              >
                Refresh Mutasi
              </button>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs">
                <thead class="border-b border-border bg-muted/40 font-mono text-muted-foreground text-[11px]">
                  <tr>
                    <th class="p-3.5">WAKTU &bull; TIMESTAMP</th>
                    <th class="p-3.5">KETERANGAN / NARRATION</th>
                    <th class="p-3.5">POSTING</th>
                    <th class="p-3.5 text-right">JUMLAH (IDR)</th>
                    <th class="p-3.5 text-right">SALDO AKHIR</th>
                  </tr>
                </thead>
                <tbody id="full-statement-tbody" class="divide-y divide-border">
                  <tr>
                    <td colspan="5" class="p-6 text-center text-muted-foreground font-mono">Memuat buku jurnal mutasi...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>

        {/* ------------------------------------------------------------------- */}
        {/* TAB 3: FUNDS TRANSFER (SNAP-BI GATEWAY) */}
        {/* ------------------------------------------------------------------- */}
        <section id="pane-transfer" class="tab-pane hidden space-y-6">
          <div class="max-w-2xl mx-auto rounded-xl border border-border bg-card p-6 shadow-sm space-y-4">
            <div class="border-b border-border pb-3">
              <h2 class="text-sm font-bold text-foreground">Transfer Dana SNAP-BI</h2>
              <p class="text-xs text-muted-foreground">Kirim dana real-time via Intrabank, BI-FAST, RTGS, atau LLG</p>
            </div>

            <form id="transfer-form-pane" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-muted-foreground pb-1">Rekening Sumber</label>
                  <input
                    type="text"
                    id="tf-source-acc"
                    readonly
                    class="w-full rounded-xl border border-border bg-muted/40 px-3 py-2 text-xs text-foreground font-mono"
                  />
                </div>

                <div>
                  <label class="block text-xs font-semibold text-muted-foreground pb-1">Kanal Kliring (Channel)</label>
                  <select
                    id="tf-channel-select"
                    onchange="onChannelChange()"
                    class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
                  >
                    <option value="INTRABANK">INTRABANK (Sesama Bank — Fee Rp 0)</option>
                    <option value="BI_FAST">BI-FAST (Antar Bank — Fee Rp 2.500)</option>
                    <option value="RTGS">RTGS (High Value Real-Time — Fee Rp 25.000)</option>
                    <option value="LLG">LLG / SKNBI (Kliring — Fee Rp 2.900)</option>
                  </select>
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-muted-foreground pb-1">Rekening Tujuan</label>
                <input
                  type="text"
                  id="tf-dest-acc"
                  required
                  placeholder="Contoh: 5240302002 atau nomor rekening bank lain"
                  class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground font-mono focus:border-primary focus:outline-none"
                />
              </div>

              <div id="external-bank-fields" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-muted-foreground pb-1">Kode Bank Tujuan (BIC/Sandi Bank)</label>
                  <input
                    type="text"
                    id="tf-ext-bank-code"
                    placeholder="BMRIIDJA (Bank Mandiri)"
                    class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground font-mono focus:border-primary focus:outline-none"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-muted-foreground pb-1">Nama Pemilik Rekening</label>
                  <input
                    type="text"
                    id="tf-ext-acc-name"
                    placeholder="Nama penerima di bank lain"
                    class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
                  />
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-muted-foreground pb-1">Nominal Transfer (IDR)</label>
                <input
                  type="number"
                  id="tf-amount-input"
                  required
                  placeholder="5000000"
                  class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground font-mono focus:border-primary focus:outline-none"
                />
              </div>

              <div>
                <label class="block text-xs font-semibold text-muted-foreground pb-1">PIN Transaksi (6 Digit)</label>
                <input
                  type="password"
                  id="tf-pin-input"
                  required
                  maxlength="6"
                  placeholder="••••••"
                  class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground font-mono focus:border-primary focus:outline-none tracking-widest"
                />
              </div>

              <div class="rounded-xl border border-border bg-muted/40 p-3 text-xs font-mono text-muted-foreground flex justify-between">
                <span>Biaya Kliring:</span>
                <span id="fee-calc-text" class="font-bold text-foreground">Rp 0</span>
              </div>

              <button
                type="submit"
                id="transfer-submit-button"
                class="w-full rounded-xl bg-primary py-2.5 text-xs font-bold text-primary-foreground hover:brightness-110 shadow-sm transition"
              >
                Kirim Transfer
              </button>
            </form>
          </div>
        </section>

        {/* ------------------------------------------------------------------- */}
        {/* TAB 4: VIRTUAL ACCOUNTS (BILLING & SETTLEMENT) */}
        {/* ------------------------------------------------------------------- */}
        <section id="pane-virtual-accounts" class="tab-pane hidden space-y-6">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {/* Pay VA */}
            <div class="rounded-xl border border-border bg-card p-6 shadow-sm space-y-4">
              <div class="border-b border-border pb-3">
                <h2 class="text-sm font-bold text-foreground">Bayar Virtual Account</h2>
                <p class="text-xs text-muted-foreground">Inquiry &amp; pelunasan tagihan Virtual Account SNAP-BI</p>
              </div>

              <form id="va-pay-form-pane" class="space-y-3">
                <div>
                  <label class="block text-xs font-semibold text-muted-foreground pb-1">Nomor Virtual Account</label>
                  <input
                    type="text"
                    id="va-pay-no-input"
                    required
                    placeholder="88000081290001001"
                    class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground font-mono focus:border-primary focus:outline-none"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-muted-foreground pb-1">PIN Transaksi</label>
                  <input
                    type="password"
                    id="va-pay-pin-input"
                    required
                    maxlength="6"
                    placeholder="••••••"
                    class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground font-mono focus:border-primary focus:outline-none tracking-widest"
                  />
                </div>
                <button
                  type="submit"
                  class="w-full rounded-xl bg-primary py-2.5 text-xs font-bold text-primary-foreground hover:brightness-110 shadow-sm transition"
                >
                  Eksekusi Pembayaran VA
                </button>
              </form>
            </div>

            {/* Create VA (Merchant / Admin) */}
            <div id="merchant-create-va-card" class="rounded-xl border border-border bg-card p-6 shadow-sm space-y-4">
              <div class="border-b border-border pb-3">
                <h2 class="text-sm font-bold text-foreground">Buat Tagihan Virtual Account (Biller)</h2>
                <p class="text-xs text-muted-foreground">Generate nomor tagihan unik SNAP-BI untuk pelanggan</p>
              </div>

              <form id="va-create-form-pane" class="space-y-3">
                <div>
                  <label class="block text-xs font-semibold text-muted-foreground pb-1">Nama Pelanggan (Customer Name)</label>
                  <input
                    type="text"
                    id="va-cust-name-input"
                    required
                    placeholder="Contoh: Budi Santoso"
                    class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-muted-foreground pb-1">Nominal Tagihan (IDR)</label>
                  <input
                    type="number"
                    id="va-bill-amount-input"
                    required
                    placeholder="1250000"
                    class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground font-mono focus:border-primary focus:outline-none"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-muted-foreground pb-1">Deskripsi Tagihan</label>
                  <input
                    type="text"
                    id="va-desc-input"
                    placeholder="Invoice #INV-2026-001"
                    class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
                  />
                </div>
                <button
                  type="submit"
                  class="w-full rounded-xl bg-blue-600 py-2.5 text-xs font-bold text-white hover:bg-blue-500 shadow-sm transition"
                >
                  Generate Virtual Account
                </button>
              </form>
            </div>
          </div>
        </section>

        {/* ------------------------------------------------------------------- */}
        {/* TAB 5: BRANCH DESK (TELLER & CS) */}
        {/* ------------------------------------------------------------------- */}
        <section id="pane-branch" class="tab-pane hidden space-y-6">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {/* Teller Cash Counter */}
            <div class="rounded-xl border border-border bg-card p-6 shadow-sm space-y-4">
              <div class="border-b border-border pb-3">
                <span class="rounded bg-amber-500/10 px-2 py-0.5 text-[10px] font-bold font-mono text-amber-400 border border-amber-500/20">TELLER DESK</span>
                <h2 class="text-sm font-bold text-foreground mt-1">Transaksi Kas Cabang (Setor &amp; Tarik Tunai)</h2>
                <p class="text-xs text-muted-foreground">Counterparty posting langsung terhadap GL Kas Utama (1001000001)</p>
              </div>

              <form id="branch-cash-form" class="space-y-3">
                <div>
                  <label class="block text-xs font-semibold text-muted-foreground pb-1">Nomor Rekening Nasabah</label>
                  <input
                    type="text"
                    id="teller-acc-input"
                    required
                    placeholder="5240301001"
                    class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground font-mono focus:border-primary focus:outline-none"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-muted-foreground pb-1">Operasi Kas</label>
                  <select
                    id="teller-op-select"
                    class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
                  >
                    <option value="DEPOSIT">SETOR TUNAI (DEPOSIT)</option>
                    <option value="WITHDRAWAL">TARIK TUNAI (WITHDRAWAL)</option>
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-muted-foreground pb-1">Nominal Tunai (IDR)</label>
                  <input
                    type="number"
                    id="teller-amount-input"
                    required
                    placeholder="10000000"
                    class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground font-mono focus:border-primary focus:outline-none"
                  />
                </div>
                <button
                  type="submit"
                  class="w-full rounded-xl bg-amber-500 py-2.5 text-xs font-bold text-black hover:bg-amber-400 shadow-sm transition"
                >
                  Proses Transaksi Kas Cabang
                </button>
              </form>
            </div>

            {/* CS PIN Unblock Desk */}
            <div class="rounded-xl border border-border bg-card p-6 shadow-sm space-y-4">
              <div class="border-b border-border pb-3">
                <span class="rounded bg-emerald-500/10 px-2 py-0.5 text-[10px] font-bold font-mono text-emerald-400 border border-emerald-500/20">CS DESK</span>
                <h2 class="text-sm font-bold text-foreground mt-1">Buka Blokir PIN (Unblock PIN)</h2>
                <p class="text-xs text-muted-foreground">Membuka blokir rekening nasabah akibat 3x kesalahan PIN</p>
              </div>

              <form id="cs-unblock-form" class="space-y-3">
                <div>
                  <label class="block text-xs font-semibold text-muted-foreground pb-1">Nomor Rekening</label>
                  <input
                    type="text"
                    id="cs-unblock-acc"
                    required
                    placeholder="5240301001"
                    class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground font-mono focus:border-primary focus:outline-none"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-muted-foreground pb-1">PIN Baru (6 Digit)</label>
                  <input
                    type="password"
                    id="cs-new-pin"
                    required
                    maxlength="6"
                    placeholder="123456"
                    class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground font-mono focus:border-primary focus:outline-none tracking-widest"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-muted-foreground pb-1">Alasan Verifikasi</label>
                  <input
                    type="text"
                    id="cs-reason"
                    value="Verifikasi KTP &amp; Biometrik di Cabang"
                    class="w-full rounded-xl border border-border bg-secondary px-3 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
                  />
                </div>
                <button
                  type="submit"
                  class="w-full rounded-xl bg-emerald-600 py-2.5 text-xs font-bold text-white hover:bg-emerald-500 shadow-sm transition"
                >
                  Reset PIN &amp; Buka Blokir
                </button>
              </form>
            </div>
          </div>
        </section>

        {/* ------------------------------------------------------------------- */}
        {/* TAB 6: OJK REGULATORY AUDIT & TRIAL BALANCE */}
        {/* ------------------------------------------------------------------- */}
        <section id="pane-audit" class="tab-pane hidden space-y-6">
          {/* Trial Balance Invariant */}
          <div class="rounded-xl border border-border bg-card p-6 shadow-sm space-y-4">
            <div class="border-b border-border pb-3 flex items-center justify-between">
              <div>
                <h2 class="text-sm font-bold text-foreground">Trial Balance Buku Besar (General Ledger Invariant)</h2>
                <p class="text-xs text-muted-foreground">Pembuktian integritas matematis: Total Debit Postings == Total Credit Postings</p>
              </div>
              <span class="rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-bold font-mono text-emerald-400 border border-emerald-500/20">
                100% BALANCED
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="rounded-xl border border-border bg-muted/30 p-4">
                <span class="text-[10px] text-muted-foreground font-mono">TOTAL DEBIT POSTINGS</span>
                <div id="audit-tb-debit" class="text-xl font-bold font-mono text-foreground mt-1">Rp 0</div>
              </div>
              <div class="rounded-xl border border-border bg-muted/30 p-4">
                <span class="text-[10px] text-muted-foreground font-mono">TOTAL CREDIT POSTINGS</span>
                <div id="audit-tb-credit" class="text-xl font-bold font-mono text-foreground mt-1">Rp 0</div>
              </div>
              <div class="rounded-xl border border-border bg-muted/30 p-4">
                <span class="text-[10px] text-muted-foreground font-mono">DISCREPANCY (SELISIH)</span>
                <div id="audit-tb-disc" class="text-xl font-bold font-mono text-emerald-400 mt-1">Rp 0</div>
              </div>
            </div>
          </div>

          {/* Audit Trail Table */}
          <div class="rounded-xl border border-border bg-card overflow-hidden">
            <div class="p-4 border-b border-border flex items-center justify-between">
              <h3 class="text-xs font-bold text-foreground uppercase tracking-wider font-mono">Regulatory Audit Trail (OJK / BI)</h3>
              <button onclick="loadAuditLogs()" class="text-xs text-primary font-mono hover:underline">Refresh Logs</button>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs">
                <thead class="border-b border-border bg-muted/40 font-mono text-muted-foreground text-[11px]">
                  <tr>
                    <th class="p-3">WAKTU</th>
                    <th class="p-3">AKSI</th>
                    <th class="p-3">RESOURCE</th>
                    <th class="p-3">IP ADDRESS</th>
                    <th class="p-3 font-mono">TRACE ID</th>
                  </tr>
                </thead>
                <tbody id="audit-logs-tbody" class="divide-y divide-border">
                  <tr>
                    <td colspan="5" class="p-4 text-center text-muted-foreground font-mono text-xs">Memuat catatan audit...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script is:inline>
      let activeToken = localStorage.getItem('cbs_token') || '';
      let currentUser = JSON.parse(localStorage.getItem('cbs_user') || 'null');

      if (!activeToken) {
        window.location.replace('/login');
      }

      function logout() {
        localStorage.removeItem('cbs_token');
        localStorage.removeItem('cbs_user');
        document.cookie = 'cbs_token=; path=/; max-age=0';
        window.location.replace('/login');
      }

      function switchTab(tabId) {
        document.querySelectorAll('.tab-pane').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.tab-btn').forEach(btn => {
          btn.classList.remove('bg-secondary', 'text-foreground');
          btn.classList.add('text-muted-foreground');
        });

        const activePane = document.getElementById('pane-' + tabId);
        const activeBtn = document.getElementById('tab-btn-' + tabId);
        if (activePane) activePane.classList.remove('hidden');
        if (activeBtn) {
          activeBtn.classList.remove('text-muted-foreground');
          activeBtn.classList.add('bg-secondary', 'text-foreground');
        }

        const titles = {
          'overview': ['Ringkasan Akun & Likuiditas', 'IDR • Zero-Trust Verified'],
          'ledger': ['Jurnal Mutasi Lengkap', 'Double-Entry General Ledger'],
          'transfer': ['Transfer Dana SNAP-BI', 'Intrabank • BI-FAST • RTGS • LLG'],
          'virtual-accounts': ['Virtual Accounts & Billing', 'SNAP-BI Open Banking Biller'],
          'branch': ['Operasional Cabang (Branch Desk)', 'Teller Cash & CS PIN Desk'],
          'audit': ['OJK Regulatory Audit & Trial Balance', 'Double-Entry Invariant Reconciliation'],
        };

        if (titles[tabId]) {
          document.getElementById('view-title').innerText = titles[tabId][0];
          document.getElementById('view-subtitle').innerText = titles[tabId][1];
        }

        if (tabId === 'ledger') loadStatement();
        if (tabId === 'audit') {
          loadTrialBalance();
          loadAuditLogs();
        }
      }

      function notify(msg, isSuccess = true) {
        const toast = document.getElementById('toast-banner');
        toast.className = `rounded-xl border p-4 text-xs font-semibold ${isSuccess ? 'border-emerald-500/20 bg-emerald-500/10 text-emerald-400' : 'border-rose-500/20 bg-rose-500/10 text-rose-400'}`;
        toast.innerText = msg;
        toast.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        setTimeout(() => toast.classList.add('hidden'), 5000);
      }

      function onChannelChange() {
        const ch = document.getElementById('tf-channel-select').value;
        const fees = { 'INTRABANK': 'Rp 0', 'BI_FAST': 'Rp 2.500', 'RTGS': 'Rp 25.000', 'LLG': 'Rp 2.900' };
        document.getElementById('fee-calc-text').innerText = fees[ch] || 'Rp 0';

        const extFields = document.getElementById('external-bank-fields');
        if (ch !== 'INTRABANK') {
          extFields.classList.remove('hidden');
        } else {
          extFields.classList.add('hidden');
        }
      }

      async function loadUserData() {
        if (!currentUser) return;
        document.getElementById('sidebar-name').innerText = currentUser.full_name;
        document.getElementById('sidebar-cif').innerText = currentUser.cif_number;
        document.getElementById('sidebar-role').innerText = currentUser.role;

        const role = currentUser.role;
        if (role === 'TELLER' || role === 'CUSTOMER_SERVICE' || role === 'ADMIN') {
          document.getElementById('nav-branch-group').classList.remove('hidden');
        } else {
          document.getElementById('nav-branch-group').classList.add('hidden');
        }

        if (role === 'AUDITOR' || role === 'ADMIN') {
          document.getElementById('nav-audit-group').classList.remove('hidden');
        } else {
          document.getElementById('nav-audit-group').classList.add('hidden');
        }

        if (currentUser.accounts && currentUser.accounts.length > 0) {
          const acc = currentUser.accounts[0];
          document.getElementById('kpi-balance').innerText = 'Rp ' + Number(acc.balance).toLocaleString('id-ID');
          document.getElementById('kpi-available').innerText = 'Rp ' + Number(acc.available_balance).toLocaleString('id-ID');
          document.getElementById('kpi-limit').innerText = 'Rp ' + Number(acc.daily_limit).toLocaleString('id-ID');
          document.getElementById('kpi-acc-no').innerText = 'Rekening: ' + acc.account_number;
          document.getElementById('kpi-tier').innerText = 'TIER: ' + acc.card_tier;
          document.getElementById('kpi-status').innerText = acc.status;
          document.getElementById('tf-source-acc').value = acc.account_number;

          loadStatement(acc.account_number);
        }
      }

      async function loadStatement(accNo) {
        const account = accNo || currentUser?.accounts?.[0]?.account_number || '5240301001';
        try {
          const res = await fetch(`http://localhost:8080/v1/accounts/${account}/statement`, {
            headers: { 'Authorization': `Bearer ${activeToken}` },
          });
          const json = await res.json();
          const items = json.data || [];

          const renderRows = (arr) => {
            if (arr.length === 0) return '<tr><td colspan="5" class="p-4 text-center text-muted-foreground font-mono">Belum ada mutasi tercatat.</td></tr>';
            return arr.map(item => `
              <tr>
                <td class="p-3.5 font-mono text-muted-foreground text-[11px]">${new Date(item.created_at).toLocaleString('id-ID')}</td>
                <td class="p-3.5 font-medium text-foreground">${item.narration}</td>
                <td class="p-3.5 font-mono font-bold ${item.direction === 'CREDIT' ? 'text-emerald-400' : 'text-rose-400'}">
                  ${item.direction}
                </td>
                <td class="p-3.5 text-right font-mono font-bold ${item.direction === 'CREDIT' ? 'text-emerald-400' : 'text-rose-400'}">
                  ${item.direction === 'CREDIT' ? '+' : '-'}Rp ${Number(item.amount).toLocaleString('id-ID')}
                </td>
                <td class="p-3.5 text-right font-mono text-muted-foreground">Rp ${Number(item.balance_after).toLocaleString('id-ID')}</td>
              </tr>
            `).join('');
          };

          const fullTbody = document.getElementById('full-statement-tbody');
          const recentTbody = document.getElementById('overview-recent-tbody');
          if (fullTbody) fullTbody.innerHTML = renderRows(items);
          if (recentTbody) recentTbody.innerHTML = renderRows(items.slice(0, 5));
        } catch (e) {
          console.error(e);
        }
      }

      async function loadTrialBalance() {
        try {
          const res = await fetch('http://localhost:8080/v1/ledger/trial-balance', {
            headers: { 'Authorization': `Bearer ${activeToken}` },
          });
          const json = await res.json();
          if (json.data) {
            document.getElementById('audit-tb-debit').innerText = 'Rp ' + Number(json.data.total_debit_postings).toLocaleString('id-ID');
            document.getElementById('audit-tb-credit').innerText = 'Rp ' + Number(json.data.total_credit_postings).toLocaleString('id-ID');
            document.getElementById('audit-tb-disc').innerText = 'Rp ' + Number(json.data.discrepancy).toLocaleString('id-ID');
          }
        } catch (e) {}
      }

      async function loadAuditLogs() {
        try {
          const res = await fetch('http://localhost:8080/v1/audit-logs', {
            headers: { 'Authorization': `Bearer ${activeToken}` },
          });
          const json = await res.json();
          const tbody = document.getElementById('audit-logs-tbody');
          if (!tbody) return;
          const items = json.data || [];
          if (items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-muted-foreground font-mono">Belum ada audit log.</td></tr>';
            return;
          }
          tbody.innerHTML = items.map(log => `
            <tr>
              <td class="p-3 font-mono text-muted-foreground text-[11px]">${new Date(log.created_at).toLocaleString('id-ID')}</td>
              <td class="p-3 font-mono font-bold text-primary">${log.action}</td>
              <td class="p-3 text-foreground">${log.resource_name} (${log.resource_id})</td>
              <td class="p-3 font-mono text-muted-foreground text-[11px]">${log.ip_address}</td>
              <td class="p-3 font-mono text-muted-foreground text-[11px]">${log.trace_id}</td>
            </tr>
          `).join('');
        } catch (e) {}
      }

      // Transfer Form Handler
      document.getElementById('transfer-form-pane')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById('transfer-submit-button');
        submitBtn.disabled = true;
        submitBtn.innerText = 'Memvalidasi & Memproses Transaksi...';

        const payload = {
          source_account_number: document.getElementById('tf-source-acc').value,
          destination_account_number: document.getElementById('tf-dest-acc').value,
          channel: document.getElementById('tf-channel-select').value,
          amount: Number(document.getElementById('tf-amount-input').value),
          pin: document.getElementById('tf-pin-input').value,
          description: 'Transfer via Core Banking Terminal',
        };

        if (payload.channel !== 'INTRABANK') {
          payload.external_bank_code = document.getElementById('tf-ext-bank-code').value || undefined;
          payload.external_account_name = document.getElementById('tf-ext-acc-name').value || undefined;
        }

        try {
          const res = await fetch('http://localhost:8080/v1/transactions/transfer', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${activeToken}`,
              'X-Idempotency-Key': 'cbs-tx-' + Date.now(),
            },
            body: JSON.stringify(payload),
          });
          const json = await res.json();
          submitBtn.disabled = false;
          submitBtn.innerText = 'Kirim Transfer';

          if (!res.ok) {
            notify(json.detail || json.message || 'Transfer ditolak oleh sistem perbankan', false);
            return;
          }

          notify(`Transfer ${payload.channel} sukses diselesaikan! Ref: ${json.data.reference_no} sebesar Rp ${Number(json.data.amount).toLocaleString('id-ID')}`, true);
          document.getElementById('tf-amount-input').value = '';
          document.getElementById('tf-pin-input').value = '';

          // Refresh balance
          if (currentUser.accounts && currentUser.accounts[0]) {
            currentUser.accounts[0].balance -= (payload.amount + json.data.fee_amount);
            currentUser.accounts[0].available_balance -= (payload.amount + json.data.fee_amount);
            localStorage.setItem('cbs_user', JSON.stringify(currentUser));
            loadUserData();
          }
        } catch (err) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Kirim Transfer';
          notify('Gagal menghubungi gateway core banking backend', false);
        }
      });

      // Pay VA Form Handler
      document.getElementById('va-pay-form-pane')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const vaNo = document.getElementById('va-pay-no-input').value;
        const pin = document.getElementById('va-pay-pin-input').value;
        const sourceAcc = currentUser?.accounts?.[0]?.account_number || '5240301001';

        try {
          const res = await fetch(`http://localhost:8080/v1/virtual-accounts/${vaNo}/pay`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${activeToken}`,
              'X-Idempotency-Key': 'cbs-va-pay-' + Date.now(),
            },
            body: JSON.stringify({ source_account_number: sourceAcc, pin }),
          });
          const json = await res.json();
          if (!res.ok) {
            notify(json.detail || json.message || 'Pembayaran Virtual Account gagal', false);
            return;
          }
          notify(`Virtual Account ${vaNo} berhasil dilunasi! Ref: ${json.data.reference_no}`, true);
          document.getElementById('va-pay-pin-input').value = '';
          loadUserData();
        } catch (err) {
          notify('Gagal memproses pembayaran Virtual Account', false);
        }
      });

      // Teller Cash Form Handler
      document.getElementById('branch-cash-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const accNo = document.getElementById('teller-acc-input').value;
        const op = document.getElementById('teller-op-select').value;
        const amount = Number(document.getElementById('teller-amount-input').value);

        try {
          const res = await fetch('http://localhost:8080/v1/transactions/cash', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${activeToken}`,
              'X-Idempotency-Key': 'teller-cash-' + Date.now(),
            },
            body: JSON.stringify({ account_number: accNo, operation: op, amount, description: 'Counter Teller Cabang' }),
          });
          const json = await res.json();
          if (!res.ok) {
            notify(json.detail || json.message || 'Transaksi kas ditolak', false);
            return;
          }
          notify(`Transaksi Kas ${op} Rp ${amount.toLocaleString('id-ID')} terhadap rekening ${accNo} berhasil diselesaikan. Ref: ${json.data.reference_no}`, true);
        } catch (err) {
          notify('Gagal memproses transaksi kas cabang', false);
        }
      });

      // CS PIN Unblock Form Handler
      document.getElementById('cs-unblock-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const accNo = document.getElementById('cs-unblock-acc').value;
        const newPin = document.getElementById('cs-new-pin').value;
        const reason = document.getElementById('cs-reason').value;

        try {
          const res = await fetch(`http://localhost:8080/v1/accounts/${accNo}/unblock-pin`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${activeToken}`,
            },
            body: JSON.stringify({ new_pin: newPin, reason }),
          });
          const json = await res.json();
          if (!res.ok) {
            notify(json.detail || json.message || 'Gagal unblock PIN', false);
            return;
          }
          notify(`PIN untuk rekening ${accNo} berhasil direset dan blokir dibuka. Status rekening: ACTIVE`, true);
          document.getElementById('cs-new-pin').value = '';
        } catch (err) {
          notify('Gagal memproses buka blokir PIN', false);
        }
      });

      // Initialize
      loadUserData();
    </script>
  </body>
</html>
