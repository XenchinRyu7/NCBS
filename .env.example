# Server & Domain Configuration
PORT=8080
APP_ENV=production
API_BASE_URL=https://cbs.api.saefulrohman.dev

# CORS & Playground Origin Whitelist
# Only domains listed here are permitted to send requests to this API.
ALLOWED_ORIGINS=https://playground.api.saefulrohman.dev
STRICT_ORIGIN_GUARD=true

# Supabase PostgreSQL (IPv4 Pooler: Port 5432 for Session/Prepared Statements, Port 6543 for Transaction Pooler)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# Upstash Redis (Serverless Redis URL)
UPSTASH_REDIS_URL=rediss://default:[password]@[endpoint].upstash.io:6379

# Security Secrets
JWT_SECRET=change-this-to-a-random-64-character-secret-key-for-production-use
API_KEY_SALT=enterprise-banking-grade-salt-2026

