# Server Configuration
PORT=8080
APP_ENV=development
API_BASE_URL=http://localhost:8080

# Supabase PostgreSQL (Transaction Pooler Port 6543 recommended for Serverless)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Upstash Redis (Serverless Redis URL)
UPSTASH_REDIS_URL=rediss://default:[password]@[endpoint].upstash.io:6379

# Security Secrets
JWT_SECRET=change-this-to-a-random-64-character-secret-key-for-production-use
API_KEY_SALT=enterprise-banking-grade-salt-2026

