---
// Production-grade enterprise router: redirect to /portal if authenticated, else /login
const token = Astro.cookies.get('cbs_token')?.value;

if (token) {
  return Astro.redirect('/portal');
}
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nusantara Core Banking System</title>
    <script is:inline>
      const localToken = localStorage.getItem('cbs_token');
      if (localToken) {
        window.location.replace('/portal');
      } else {
        window.location.replace('/login');
      }
    </script>
  </head>
  <body class="bg-background text-foreground">
    <div class="flex h-screen w-screen items-center justify-center">
      <div class="flex items-center gap-2 text-xs font-mono text-muted-foreground">
        <span class="h-2 w-2 animate-ping rounded-full bg-primary"></span>
        Redirecting to Core Banking Terminal...
      </div>
    </div>
  </body>
</html>
