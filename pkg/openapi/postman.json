    {
      "name": "02 - CIF, Account Opening & Balance Inquiry",
      "item": [
        {
          "name": "List Accounts (Role-Scoped)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/accounts",
              "host": ["{{base_url}}"],
              "path": ["accounts"]
            },
            "description": "`CUSTOMER`/`MERCHANT` sees only their own accounts; `TELLER`/`CS`/`AUDITOR`/`ADMIN` sees all accounts across the bank."
          }
        },
        {
          "name": "Real-Time Balance Inquiry (Rek 5240301001)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/accounts/{{customer_account}}/balance",
              "host": ["{{base_url}}"],
              "path": ["accounts", "{{customer_account}}", "balance"]
            },
            "description": "Returns Available Balance, Hold Amount, Ledger Balance, and Account Status."
          }
        },
        {
          "name": "Account Statement / Mutasi Rekening (Rek 5240301001)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/accounts/{{customer_account}}/statement?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["accounts", "{{customer_account}}", "statement"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            },
            "description": "Returns chronological Debit/Credit ledger postings and running balance after every transaction."
          }
        },
        {
          "name": "Open Additional Account (SAVINGS / TIME_DEPOSIT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "X-Idempotency-Key",
                "value": "IDEMP-OPENACC-{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cif_number\": \"CIF-2026-0001\",\n  \"account_type\": \"SAVINGS\",\n  \"card_tier\": \"GOLD\",\n  \"pin\": \"123456\",\n  \"initial_deposit\": 5000000\n}"
