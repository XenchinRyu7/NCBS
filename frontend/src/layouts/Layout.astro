---
import '../styles/globals.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  activeRole?: string;
  cifNumber?: string;
  fullName?: string;
}

const {
  title = 'Nusantara Core Banking System (NCBS)',
  activeRole,
  cifNumber,
  fullName,
} = Astro.props;
---

<!doctype html>
<html lang="id" class="dark" data-color-theme="custom">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Enterprise Core Banking</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏦</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link id="ethereal-theme-link" rel="stylesheet" href="/themes/claude.css" />
    <script is:inline>
      // Prevent theme flash on load with official Ethereal OKLCH themes
      const mode = localStorage.getItem('cbs_theme_mode') || 'dark';
      const color = localStorage.getItem('cbs_color_theme') || 'claude';
      if (mode === 'dark') {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
      } else {
        document.documentElement.classList.add('light');
        document.documentElement.classList.remove('dark');
      }
      document.documentElement.setAttribute('data-color-theme', 'custom');
      const themeLink = document.getElementById('ethereal-theme-link');
      if (themeLink) themeLink.href = `/themes/${color}.css`;
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased selection:bg-primary/20 selection:text-primary">
    {/* Global Telemetry Navigation Bar */}
    <header class="sticky top-0 z-50 w-full border-b border-border bg-card/80 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        {/* Brand */}
        <div class="flex items-center gap-3">
          <a href="/portal" class="flex items-center gap-2.5 transition hover:opacity-90">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary text-primary-foreground font-black text-lg shadow-sm shadow-primary/20">
              N
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-bold tracking-tight text-foreground text-sm sm:text-base">NUSANTARA CBS</span>
                <span class="rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-semibold text-primary border border-primary/20">v2.4-RUST</span>
              </div>
              <p class="text-[10px] text-muted-foreground font-mono">SNAP-BI &bull; ISO 20022 CORE LEDGER</p>
            </div>
          </a>
        </div>

        {/* Live Integrity, Theme Controls & Nav Links */}
        <div class="flex items-center gap-2 sm:gap-4">
          <div class="hidden items-center gap-2 rounded-full border border-border bg-muted/60 px-3 py-1 text-xs md:flex">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            <span class="text-muted-foreground font-mono text-[11px]">LEDGER STATUS:</span>
            <span class="font-semibold text-emerald-400 font-mono text-[11px]">100% BALANCED</span>
          </div>

          {/* Theme & Mode Switcher */}
          <ThemeToggle />

          <nav class="flex items-center gap-1.5 text-xs">
            <a href="http://localhost:8080/docs" target="_blank" class="rounded-lg px-2.5 py-1.5 text-muted-foreground transition hover:bg-muted hover:text-foreground">API Docs</a>
            
            {activeRole ? (
              <div class="flex items-center gap-2 pl-2">
                <span class="rounded-lg border border-primary/30 bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary">
                  {activeRole}
                </span>
                <button
                  id="logout-btn"
                  onclick="localStorage.removeItem('cbs_token'); localStorage.removeItem('cbs_user'); document.cookie='cbs_token=; path=/; max-age=0'; window.location.href='/login';"
                  class="rounded-lg border border-border bg-secondary px-2.5 py-1 text-xs font-medium text-secondary-foreground hover:bg-destructive/20 hover:text-destructive hover:border-destructive/30 transition cursor-pointer"
                >
                  Keluar
                </button>
              </div>
            ) : (
              <a
                href="/login"
                class="rounded-lg bg-primary px-3 py-1.5 font-semibold text-primary-foreground shadow-sm transition hover:brightness-110"
              >
                Masuk Terminal
              </a>
            )}
          </nav>
        </div>
      </div>
    </header>

    {/* Main Container */}
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>

    {/* Footer */}
    <footer class="mt-16 border-t border-border bg-card/40 py-8 text-center text-xs text-muted-foreground">
      <div class="mx-auto max-w-7xl px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="font-mono">
          Nusantara Core Banking System &bull; Enterprise Monorepo (Rust Engine + Astro SSR)
        </p>
        <p class="text-[11px]">
          Compliant with Bank Indonesia SNAP-BI standard &amp; Double-Entry General Ledger
        </p>
      </div>
    </footer>
  </body>
</html>
