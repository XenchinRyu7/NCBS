  "item": [
    {
      "name": "00 - Environment & Trial Sandbox Control",
      "item": [
        {
          "name": "Health Check & Double-Entry Invariant Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/system/health",
              "host": ["{{base_url}}"],
              "path": ["system", "health"]
            },
            "description": "Checks database health, environment scope (`TRIAL_SANDBOX`), and verifies `SUM(Debit) == SUM(Credit)` across the General Ledger."
          }
        },
        {
          "name": "Get Sandbox API Key & Environment Routes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partner_name\": \"API Playground Demo Reviewer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/sandbox-key",
              "host": ["{{base_url}}"],
              "path": ["auth", "sandbox-key"]
            },
            "description": "Returns the active `X-API-Key` (`cbs_trial_snap_sandbox_2026`), route matrix (`/trial/v1`, `/dev/v1`, `/v1`), and demo role credentials."
          }
        },
        {
          "name": "List All 6 Banking Roles & Permission Matrix",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/roles",
              "host": ["{{base_url}}"],
              "path": ["auth", "roles"]
            },
            "description": "Displays all 6 enterprise roles (`CUSTOMER`, `MERCHANT`, `TELLER`, `CUSTOMER_SERVICE`, `AUDITOR`, `ADMIN`), their demo login emails, and granular capabilities."
          }
        },
        {
          "name": "Reset Trial Sandbox State to Clean Genesis",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/system/reset",
              "host": ["{{base_url}}"],
              "path": ["system", "reset"]
            },
            "description": "Exclusive to `/trial/v1` and `/dev/v1`. Resets all demo account balances, Virtual Accounts, PIN counters, and General Ledger entries back to their initial clean state."
          }
        }
      ]
    },
