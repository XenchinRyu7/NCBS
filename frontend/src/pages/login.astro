---
import '../styles/globals.css';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<!doctype html>
<html lang="id" class="dark" data-color-theme="claude">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Otentikasi — Nusantara Core Banking System</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏦</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>
      const mode = localStorage.getItem('cbs_theme_mode') || 'dark';
      const color = localStorage.getItem('cbs_color_theme') || 'claude';
      if (mode === 'dark') {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
      } else {
        document.documentElement.classList.add('light');
        document.documentElement.classList.remove('dark');
      }
      document.documentElement.setAttribute('data-color-theme', color);
      if (color !== 'default') {
        const link = document.createElement('link');
        link.id = 'ethereal-active-theme';
        link.rel = 'stylesheet';
        link.href = `/themes/${color}.css`;
        document.head.appendChild(link);
      }
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground flex flex-col justify-between p-4 sm:p-8 antialiased selection:bg-primary/20 selection:text-primary">
    {/* Top Header Telemetry */}
    <header class="flex items-center justify-between mx-auto w-full max-w-5xl">
      <div class="flex items-center gap-2.5">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground font-black text-sm shadow-sm">
          N
        </div>
        <div>
          <span class="font-bold tracking-tight text-xs sm:text-sm text-foreground">NUSANTARA CBS</span>
          <span class="text-[10px] text-muted-foreground font-mono block">ENTERPRISE CORE LEDGER</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="hidden sm:flex items-center gap-2 rounded-full border border-border bg-card/60 px-3 py-1 text-[11px] font-mono text-muted-foreground">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          <span>GATEWAY:</span>
          <span class="text-emerald-400 font-semibold">JKT-DC1 (LIVE)</span>
        </div>

        <ThemeToggle />
      </div>
    </header>

    {/* Center Login Terminal */}
    <main class="mx-auto w-full max-w-sm sm:max-w-md my-auto py-8">
      <div class="rounded-2xl border border-border bg-card p-6 sm:p-8 shadow-2xl space-y-6">
        <div class="space-y-1.5 text-center">
          <div class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/80 px-2.5 py-0.5 text-[10px] font-mono text-muted-foreground">
            ZERO-TRUST IDENTITY GATEWAY
          </div>
          <h1 class="text-xl font-bold tracking-tight text-foreground sm:text-2xl">
            Akses Terminal Perbankan
          </h1>
          <p class="text-xs text-muted-foreground">
            Masukkan kredensial akun perbankan untuk membuka sesi kerja terenkripsi.
          </p>
        </div>

        {/* Error Alert Box */}
        <div id="error-alert" class="hidden rounded-xl border border-destructive/20 bg-destructive/10 p-3 text-xs text-destructive space-y-1">
          <div class="font-semibold" id="error-title">Gagal Otentikasi</div>
          <div class="text-[11px] opacity-90" id="error-desc">Periksa kembali email dan password Anda.</div>
        </div>

        <form id="auth-form" class="space-y-4">
          <div class="space-y-1.5">
            <label for="email" class="block text-xs font-semibold text-foreground">
              Alamat Email / CIF Terdaftar
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="nama@cbs-bank.co.id"
              class="w-full rounded-xl border border-border bg-card text-card-foreground placeholder:text-muted-foreground px-3.5 py-2.5 text-xs focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition"
            />
          </div>

          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label for="password" class="block text-xs font-semibold text-foreground">
                Kata Sandi
              </label>
              <a href="#" tabindex="-1" class="text-[11px] text-muted-foreground hover:text-foreground">Lupa sandi?</a>
            </div>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                autocomplete="current-password"
                placeholder="••••••••••••"
                class="w-full rounded-xl border border-border bg-card text-card-foreground placeholder:text-muted-foreground px-3.5 py-2.5 text-xs focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition"
              />
              <button
                type="button"
                id="toggle-pwd-btn"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground text-xs"
              >
                Tampilkan
              </button>
            </div>
          </div>

          <div class="flex items-center justify-between pt-1">
            <label class="flex items-center gap-2 cursor-pointer">
              <input
                type="checkbox"
                id="remember-me"
                class="rounded border-border bg-card text-primary focus:ring-0 cursor-pointer h-3.5 w-3.5"
              />
              <span class="text-xs text-muted-foreground">Ingat terminal ini</span>
            </label>
            <span class="text-[11px] font-mono text-muted-foreground">SNAP-BI v2.4</span>
          </div>

          <button
            type="submit"
            id="login-btn"
            class="w-full rounded-xl bg-primary py-2.5 text-xs font-bold text-primary-foreground hover:brightness-110 shadow-sm transition flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>Otentikasi &amp; Buka Sesi</span>
          </button>
        </form>

        <div class="border-t border-border pt-4 text-center">
          <p class="text-[11px] text-muted-foreground leading-relaxed">
            Sistem dilindungi enkripsi TLS 1.3 &amp; otentikasi zero-trust. Setiap akses tercatat pada <strong>Regulatory Audit Trail</strong> Bank Indonesia &amp; OJK.
          </p>
        </div>
      </div>
    </main>

    {/* Footer Security Advisory */}
    <footer class="mx-auto w-full max-w-5xl text-center sm:text-left flex flex-col sm:flex-row items-center justify-between text-[11px] text-muted-foreground font-mono gap-2">
      <div>PT Bank Nusantara Core Tbk &bull; Berizin &amp; Diawasi oleh OJK</div>
      <div>SESSION_SECURITY: LEVEL_4_STRICT</div>
    </footer>

    <script is:inline>
      const form = document.getElementById('auth-form');
      const emailInput = document.getElementById('email');
      const passwordInput = document.getElementById('password');
      const togglePwdBtn = document.getElementById('toggle-pwd-btn');
      const loginBtn = document.getElementById('login-btn');
      const errorAlert = document.getElementById('error-alert');
      const errorTitle = document.getElementById('error-title');
      const errorDesc = document.getElementById('error-desc');

      togglePwdBtn.addEventListener('click', () => {
        if (passwordInput.type === 'password') {
          passwordInput.type = 'text';
          togglePwdBtn.innerText = 'Sembunyikan';
        } else {
          passwordInput.type = 'password';
          togglePwdBtn.innerText = 'Tampilkan';
        }
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorAlert.classList.add('hidden');
        loginBtn.disabled = true;
        loginBtn.innerHTML = '<span class="inline-block animate-spin mr-1">⟳</span> Mengautentikasi kredensial...';

        const email = emailInput.value.trim();
        const password = passwordInput.value;

        try {
          const res = await fetch('http://localhost:8080/v1/auth/token', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });

          const json = await res.json();

          if (!res.ok) {
            errorTitle.innerText = json.title || 'Otentikasi Ditolak';
            errorDesc.innerText = json.detail || json.message || 'Kredensial perbankan tidak valid.';
            errorAlert.classList.remove('hidden');
            loginBtn.disabled = false;
            loginBtn.innerHTML = '<span>Otentikasi &amp; Buka Sesi</span>';
            return;
          }

          const tokenData = json.data;
          localStorage.setItem('cbs_token', tokenData.access_token);
          localStorage.setItem('cbs_user', JSON.stringify(tokenData));
          document.cookie = `cbs_token=${tokenData.access_token}; path=/; max-age=86400; SameSite=Lax`;

          window.location.replace('/portal');
        } catch (err) {
          errorTitle.innerText = 'Koneksi Gateway Gagal';
          errorDesc.innerText = 'Tidak dapat menghubungi server Core Banking di localhost:8080. Pastikan backend Rust aktif.';
          errorAlert.classList.remove('hidden');
          loginBtn.disabled = false;
          loginBtn.innerHTML = '<span>Otentikasi &amp; Buka Sesi</span>';
        }
      });
    </script>
  </body>
</html>
